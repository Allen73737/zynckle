# Copy to .env in the repository root. Values already set in the process environment win.
# Never commit .env — it is ignored by git.

# --- API server ---
PORT=8080
HOST=127.0.0.1
# Comma-separated list of browser origins allowed to call the API directly (Vite dev server by default).
ZYNCKLE_FRONTEND_ORIGIN=http://localhost:5173
# Public URL used in links (password reset, verification, OAuth callback). Defaults to the first origin.
ZYNCKLE_PUBLIC_URL=
# 32+ character secret for signed file URLs. Generated into backend/data/.secret if empty.
ZYNCKLE_SECRET=
# Show password-reset / verification links in API responses (development only; never in production).
ZYNCKLE_EXPOSE_DEV_LINKS=true
# Optional: custom data file location (JSON metadata store).
ZYNCKLE_DATA_FILE=

# --- Limits ---
MAX_UPLOAD_MB=25
MAX_ZIP_MB=40
WORKSPACE_QUOTA_MB=1024
AUTH_RATE_PER_MINUTE=12

# --- AI providers (keys stay on the server) ---
# groq | gemini | openrouter — defaults to the first configured provider, preferring Groq.
AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
AI_REQUESTS_PER_MINUTE=20
AI_REQUESTS_PER_DAY=400
AI_CONTEXT_CHARS=28000

# --- Object storage: Cloudflare R2 or any S3-compatible bucket (local disk when empty) ---
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# --- Google sign-in (redirect URI: <ZYNCKLE_PUBLIC_URL>/api/auth/google/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LaTeX (MiKTeX or TeX Live). Leave empty to auto-detect pdflatex. ---
LATEX_COMPILER=

# --- Spring Boot / PostgreSQL foundation (backend/src; not used by the running Node API) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/zynckle
DATABASE_USERNAME=zynckle
DATABASE_PASSWORD=change-me
